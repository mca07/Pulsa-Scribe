<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape><solid android:color="?attr/pl_accent_soft" /><corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="?attr/pl_accent" /></shape>
    </item>
    <item>
        <shape><solid android:color="?attr/pl_surface" /><corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="?attr/pl_divider" /></shape>
    </item>
</selector>
