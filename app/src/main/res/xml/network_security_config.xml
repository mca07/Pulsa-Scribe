<?xml version="1.0" encoding="utf-8"?>
<!-- Nur HTTPS, nur System-Zertifikate (keine vom Nutzer installierten CAs) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
