<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/pl_bg" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/header_bg"
        android:paddingStart="18dp" android:paddingEnd="6dp" android:paddingTop="10dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textSize="22sp" android:textStyle="bold"
                android:textColor="?attr/pl_header_text" android:accessibilityHeading="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/main_subtitle" android:textSize="13sp" android:textColor="?attr/pl_header_muted" />
        </LinearLayout>
        <ImageButton android:id="@+id/main_search" style="@style/HeaderIconButton"
            android:src="@drawable/ic_search" android:contentDescription="@string/search_all_hint" />
        <ImageButton android:id="@+id/main_settings" style="@style/HeaderIconButton"
            android:src="@drawable/ic_settings" android:contentDescription="@string/settings" />
    </LinearLayout>

    <!-- Suche über alles -->
    <LinearLayout android:id="@+id/main_search_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
        android:paddingStart="12dp" android:paddingEnd="4dp" android:paddingTop="8dp">
        <EditText android:id="@+id/main_search_input" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:background="@drawable/input_bg" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:hint="@string/search_all_hint" android:inputType="text" android:imeOptions="actionSearch"
            android:maxLength="60" android:textColor="?attr/pl_text" android:textColorHint="?attr/pl_muted" android:textSize="15sp" />
        <ImageButton android:id="@+id/main_search_close" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_close"
            android:tint="?attr/pl_muted" android:contentDescription="@string/close" />
    </LinearLayout>

    <!-- Auswahl (langes Drücken) -->
    <LinearLayout android:id="@+id/main_select_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
        android:background="?attr/pl_accent_soft" android:paddingStart="4dp" android:paddingEnd="4dp">
        <ImageButton android:id="@+id/sel_close" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_close"
            android:tint="?attr/pl_text" android:contentDescription="@string/sel_close" />
        <TextView android:id="@+id/sel_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="4dp" android:textColor="?attr/pl_text" android:textSize="16sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/sel_all" android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/sel_all"
            android:textColor="?attr/pl_accent" android:textSize="15sp" android:background="@drawable/crumb_bg"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/sel_move" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginStart="4dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="12dp"
            android:drawableStart="@drawable/ic_folder" android:drawablePadding="6dp" android:text="@string/sel_move_short"
            android:textColor="?attr/pl_accent" android:textSize="15sp" android:background="@drawable/crumb_bg"
            android:maxLines="1" android:clickable="true" android:focusable="true"
            android:contentDescription="@string/sel_move" />
        <ImageButton android:id="@+id/sel_delete" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_delete"
            android:contentDescription="@string/sel_delete" />
    </LinearLayout>

    <!-- Ordnerpfad -->
    <LinearLayout android:id="@+id/main_crumbs_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="4dp" android:paddingTop="6dp">
        <HorizontalScrollView android:id="@+id/main_crumbs_scroll" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:scrollbars="none">
            <LinearLayout android:id="@+id/main_crumbs" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" />
        </HorizontalScrollView>
        <ImageButton android:id="@+id/main_new_folder" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_folder_add"
            android:contentDescription="@string/folder_new" />
        <ImageButton android:id="@+id/main_folder_more" android:layout_width="44dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_more"
            android:contentDescription="@string/more" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/main_list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:dividerHeight="0dp" android:clipToPadding="false"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="12dp"
            android:listSelector="@android:color/transparent" />
        <TextView android:id="@+id/main_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="32dp" android:text="@string/empty"
            android:textColor="?attr/pl_muted" android:textSize="16sp" android:lineSpacingMultiplier="1.2"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="?attr/pl_surface"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/main_record" style="@style/Button.Secondary"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="52dp" android:drawableStart="@drawable/ic_mic" android:drawablePadding="8dp"
                android:drawableTint="?attr/pl_accent" android:gravity="center" android:text="@string/record" />
            <Button android:id="@+id/main_pick" style="@style/Button.Primary"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:drawableStart="@drawable/ic_file" android:drawablePadding="8dp" android:drawableTint="?attr/pl_on_accent"
                android:gravity="center" android:text="@string/pick_file" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
